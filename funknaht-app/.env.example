# Kopieren nach .env.local und bei Bedarf anpassen.

# Neue Firmen dürfen sich selbst registrieren (1) oder nicht (0).
ALLOW_SIGNUP=1

# Optional: eigener Pfad zur Datenbank (Standard: data/funknaht.sqlite)
# SQLITE_PATH=D:/funknaht/funknaht.sqlite

# Optional: Ziel und Anzahl der Sicherungen für "npm run backup"
# BACKUP_DIR=D:/funknaht/backups
# BACKUP_KEEP=14

# Nur für einen lokalen Produktionstest ohne HTTPS: Cookies ohne Secure-Flag.
# INSECURE_COOKIES=1

# --- KI-Assistent in der Hilfe (optional) -------------------------------------
# Ohne diese Angaben antwortet die Hilfe aus der eingebauten Anleitung.
# Jeder Dienst mit OpenAI-kompatibler Schnittstelle funktioniert.
#
# Kostenlos und ohne Datenabfluss: Ollama auf dem eigenen Server (https://ollama.com)
#   ollama pull <modell>      danach:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=<modell>
#
# Kostenlose Kontingente bei Anbietern (Schlüssel im jeweiligen Konto anlegen, Grenzen dort prüfen):
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1          AI_MODEL=openai/gpt-oss-120b   AI_REASONING_EFFORT=low
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1        (Modelle mit ":free")
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=<schlüssel>
# Ohne Schlüssel gilt ein externer Anbieter als nicht eingerichtet; ein lokales Modell braucht keinen.
#
# Externe Anbieter erhalten nur die Frage und die Anleitung. Summen der Firma
# (Anzahl offener Rechnungen usw., keine Namen) gehen nur an ein lokales Modell –
# oder an einen Anbieter, wenn Sie das hier ausdrücklich erlauben:
# AI_SHARE_FIGURES=1
# AI_TIMEOUT_SECONDS=45

# --- Web Push (Erinnerungen bei geschlossenem Browser) --------------------------
# Ohne Angaben erzeugt Nahtbord beim ersten Start ein Schlüsselpaar und speichert es
# in der Steuer-Datenbank. Eigene Schlüssel: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontakt für die Push-Dienste (https-Adresse oder mailto:)
# VAPID_SUBJECT=mailto:support@example.de
# Hintergrundprüfung abschalten (z. B. wenn mehrere Server-Prozesse dieselbe Datenbank nutzen):
# PUSH_SCHEDULER=0
